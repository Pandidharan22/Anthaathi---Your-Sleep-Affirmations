# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
#
# Both variables must be prefixed with EXPO_PUBLIC_ to be available in client code
# (Expo's convention for build-time env vars). This is fine for these specific values:
# the Supabase "anon" key is designed to be embedded in a shipped client and is safe
# to expose — access control is enforced by Postgres row-level security, not by
# keeping this key secret. The Supabase "service_role" key is the actual secret and
# must never appear here or anywhere in client code.

# Project Settings -> API Keys -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> anon / public (or "publishable") key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
