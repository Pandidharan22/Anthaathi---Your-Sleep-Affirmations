# Claude Code local instructions (machine-local, not shared via git)
CLAUDE.md

# Environment / secrets — never commit real values
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native build output (regenerated via `expo prebuild` / EAS — not hand-edited).
# Anchored to the repo root (leading slash) -- an unanchored `android/`/`ios/`
# would also match modules/<name>/android/, silently excluding real native
# module source from git and (since EAS Build respects .gitignore) from builds.
/ios/
/android/
/.kotlin/
*.orig.*

# Metro
.metro-health-check*

# Signing / credentials — must never be committed
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# EAS
.eas/

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db
*.pem

# TypeScript
*.tsbuildinfo

# Editors
.vscode/
.idea/

# Misc
*.tmp
.cache/
coverage/

# Local design exports (design lives on claude.ai, not in this repo — see Dev_Journal.md)
Anthaathi UI Design.html

# Raw bed source recordings (large; processed loops in assets/beds/ are committed)
/assets/beds/source/*
!/assets/beds/source/README.md
